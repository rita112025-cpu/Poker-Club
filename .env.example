# Copy to .env and replace before exposing the service.
POSTGRES_USER=poker
POSTGRES_PASSWORD=replace-with-a-long-local-password
POSTGRES_DB=poker_club
APP_PORT=8080
DB_PORT=5432
# Local backend only; Compose constructs its own URL from POSTGRES_*.
DATABASE_URL=postgresql+psycopg://poker:replace-with-a-long-local-password@localhost:5432/poker_club
CORS_ORIGINS=["http://localhost:5173"]
